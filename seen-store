#!/usr/bin/env python3
import os
import stat
import sys

SEEN = "seen.json"
TMP = ".seen.json.tmp"
MAX_BYTES = 8192
DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
TMP_FLAGS = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC


def die(msg):
    print(msg, file=sys.stderr)
    raise SystemExit(1)


def pin_dir(path):
    if not path or "\0" in path:
        die("invalid path")
    path = os.path.abspath(path)
    parent = os.path.dirname(path)
    if parent:
        try:
            os.makedirs(parent, exist_ok=True)
        except OSError:
            die("cannot create state parent")
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    except OSError:
        die("cannot create state dir")
    try:
        fd = os.open(path, DIR_FLAGS)
    except OSError:
        die("state dir is not private")
    try:
        st = os.fstat(fd)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
            die("state dir is not private")
        os.fchmod(fd, 0o700)
        st = os.fstat(fd)
        if stat.S_IMODE(st.st_mode) != 0o700:
            die("state dir is not private")
        return fd
    except SystemExit:
        os.close(fd)
        raise
    except OSError:
        os.close(fd)
        die("state dir is not private")


def load(dirfd):
    try:
        fd = os.open(SEEN, FILE_FLAGS, dir_fd=dirfd)
    except FileNotFoundError:
        return b""
    except OSError:
        die("seen.json is not private")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
            die("seen.json is not private")
        if st.st_size > MAX_BYTES:
            die("seen.json too large")
        os.fchmod(fd, 0o600)
        st = os.fstat(fd)
        if stat.S_IMODE(st.st_mode) != 0o600:
            die("seen.json is not private")
        data = os.read(fd, MAX_BYTES + 1)
        if len(data) > MAX_BYTES:
            die("seen.json too large")
        return data
    finally:
        os.close(fd)


def save(dirfd, data):
    if len(data) > MAX_BYTES:
        die("payload too large")
    try:
        os.unlink(TMP, dir_fd=dirfd)
    except FileNotFoundError:
        pass
    except OSError:
        die("cannot replace temp file")
    try:
        fd = os.open(TMP, TMP_FLAGS, 0o600, dir_fd=dirfd)
    except OSError:
        die("cannot create temp file")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
            die("temp file is not private")
        os.fchmod(fd, 0o600)
        written = 0
        while written < len(data):
            written += os.write(fd, data[written:])
        os.fsync(fd)
    except Exception:
        os.close(fd)
        try:
            os.unlink(TMP, dir_fd=dirfd)
        except OSError:
            pass
        raise
    os.close(fd)
    try:
        os.rename(TMP, SEEN, src_dir_fd=dirfd, dst_dir_fd=dirfd)
        os.fsync(dirfd)
    except OSError:
        try:
            os.unlink(TMP, dir_fd=dirfd)
        except OSError:
            pass
        die("cannot publish seen.json")


def main():
    if len(sys.argv) != 3 or sys.argv[1] not in ("load", "save"):
        die("usage: seen-store load|save DIR")
    dirfd = pin_dir(sys.argv[2])
    try:
        if sys.argv[1] == "load":
            sys.stdout.buffer.write(load(dirfd))
            return
        data = sys.stdin.buffer.readline(MAX_BYTES + 2)
        if len(data) > MAX_BYTES:
            die("payload too large")
        save(dirfd, data)
    finally:
        os.close(dirfd)


if __name__ == "__main__":
    main()
