#!/usr/bin/env python3
import subprocess
import sys

if len(sys.argv) < 3:
    print("usage: capped-run MAX cmd [args...]", file=sys.stderr)
    raise SystemExit(2)

try:
    limit = int(sys.argv[1])
except ValueError:
    print("capped-run: MAX must be an integer", file=sys.stderr)
    raise SystemExit(2)
if limit < 0:
    print("capped-run: MAX must be >= 0", file=sys.stderr)
    raise SystemExit(2)

proc = subprocess.Popen(sys.argv[2:], stdout=subprocess.PIPE)
try:
    data = proc.stdout.read(limit + 1)
    if len(data) > limit:
        proc.kill()
        proc.wait()
        raise SystemExit(1)
finally:
    if proc.stdout:
        proc.stdout.close()

sys.stdout.buffer.write(data)
raise SystemExit(0 if proc.wait() == 0 else 1)
