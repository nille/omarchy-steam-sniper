#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
shell_dir="${OMARCHY_PATH:-/usr/share/omarchy}/shell"

if [[ ! -d "$shell_dir/Ui" ]]; then
  echo "error: $shell_dir/Ui not found — is Omarchy 4 installed?" >&2
  exit 1
fi

shim="$(mktemp -d)"
state="$(mktemp -d)"
trap 'rm -rf "$shim" "$state"' EXIT
mkdir -p "$shim/qs"
ln -s "$shell_dir/Ui" "$shim/qs/Ui"
ln -s "$shell_dir/Commons" "$shim/qs/Commons"

QML_IMPORT_PATH="$shim${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
STEAM_SNIPER_DIR="$root" \
STEAM_SNIPER_STATE="$state" \
  exec quickshell -p "$here/shell.qml" "$@"
