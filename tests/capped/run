#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
cap=(python3 "$root/capped-run")

fail() { echo "FAIL: $*" >&2; exit 1; }
ok() { echo "ok $*"; }

got="$("${cap[@]}" 100 printf 'hello')"
[[ "$got" == "hello" ]] || fail "short output: $got"
ok "pass through"

if "${cap[@]}" 8 python3 -c "import sys; sys.stdout.buffer.write(b'x'*20)" >/dev/null 2>&1; then
  fail "oversized stdout was accepted"
fi
ok "reject oversized"

if "${cap[@]}" 100 python3 -c "import sys; sys.exit(7)"; then
  fail "child failure was accepted"
fi
ok "propagate child status"
