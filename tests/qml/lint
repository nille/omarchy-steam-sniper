#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
shell_dir="${OMARCHY_PATH:-/usr/share/omarchy}/shell"

shim="$(mktemp -d)"
trap 'rm -rf "$shim"' EXIT
mkdir -p "$shim/qs"
ln -s "$shell_dir/Ui" "$shim/qs/Ui"
ln -s "$shell_dir/Commons" "$shim/qs/Commons"

exec /usr/lib/qt6/bin/qmllint -I "$shim" \
  "$root/Panel.qml" \
  "$root/WrappingPanelHero.qml" \
  "$root/tests/qml/tst_wrapping_panel_hero.qml" \
  "$root/tests/harness/shell.qml"
